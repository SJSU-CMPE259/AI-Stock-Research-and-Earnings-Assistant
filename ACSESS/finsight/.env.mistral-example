# Example: Using Mistral via vLLM on PSC Bridges-2

SEC_USER_AGENT="Your Full Name your.email@sjsu.edu"

# Remote vLLM setup (PSC Bridges-2)
LLM_PROVIDER=remote
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.1
REMOTE_LLM_URL=http://localhost:8000/v1

# Other settings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/finsight.db
DEBUG=true
LLM_CACHE_ENABLED=true

# To use this:
# 1. Start vLLM on PSC: python -m vllm.entrypoints.openai.api_server --model mistralai/Mistral-7B-Instruct-v0.1 --dtype half --port 8000 --host 0.0.0.0
# 2. Port forward: ssh -L 8000:v002:8000 mrajpurohit@bridges2.psc.edu
# 3. Copy to .env: cp .env.mistral-example .env
# 4. Test: python test_mistral.py
