# SEC API credentials (required)
# Full Name and Email: SEC requires a User-Agent with your name and email
SEC_USER_AGENT="Your Full Name your.email@sjsu.edu"

# LLM Provider Configuration
LLM_PROVIDER=anthropic  # Options: anthropic, openai
LLM_MODEL=claude-opus-5  # E.g. claude-opus-5, gpt-4-turbo, etc.

# API Keys (provide at least one based on LLM_PROVIDER)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Embeddings model
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/finsight.db

# API Configuration
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Debug mode
DEBUG=false

# LLM Caching
LLM_CACHE_ENABLED=true
