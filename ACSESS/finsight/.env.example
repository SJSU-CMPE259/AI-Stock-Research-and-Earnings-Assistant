# SEC API credentials (required)
# Full Name and Email: SEC requires a User-Agent with your name and email
SEC_USER_AGENT="Your Full Name your.email@sjsu.edu"

# LLM Provider Configuration
# Options: anthropic, openai, remote
# Use 'remote' for vLLM, ollama, or other OpenAI-compatible endpoints
LLM_PROVIDER=remote
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# API Keys (provide based on LLM_PROVIDER)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Remote LLM endpoint (required if LLM_PROVIDER=remote)
# E.g., vLLM on PSC: http://localhost:8000/v1
# E.g., local ollama: http://localhost:11434/v1
REMOTE_LLM_URL=http://localhost:8000/v1

# Embeddings model
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/finsight.db

# API Configuration
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Debug mode
DEBUG=false

# LLM Caching
LLM_CACHE_ENABLED=true
